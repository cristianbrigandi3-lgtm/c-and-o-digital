# Configurazione server: lasciare CONTACT_ENABLED=false finché il lancio non è pronto.
CONTACT_ENABLED=false
ALLOWED_ORIGIN=

# Gmail SMTP: credenziali server-side. Non inserirle nel browser o nel repository.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Rate limit persistente e condiviso fra funzioni Vercel/Netlify.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Impostazioni build del sito (SITE_PRELAUNCH=false solo dopo approvazione legale).
SITE_PRELAUNCH=true
SITE_URL=
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_TAX_ID=
LEGAL_VAT_OR_REASON=
LEGAL_REGISTER_OR_REASON=
CONTACT_EMAIL=
CONTACT_RETENTION=
HOSTING_PROVIDER=
EMAIL_PROVIDER=
REDIS_PROVIDER_AND_REGION=
PRIVACY_TEXT_APPROVED=false
TERMS_TEXT_APPROVED=false
